{
  "manifest_version": 3,
  "name": "MTG Enhancements",
  "version": "0.2",
  "description": "Add features to popular MTG websites.",
  "icons": {
    "16": "icon_16.png",
    "32": "icon_32.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.scryfall.com/card/*",
        "https://*.scryfall.com/search*"
    ],
      "js": ["scryfall.js"]
    },
    {
      "matches": [
        "https://*.mtgtop8.com/topcards*"
    ],
      "js": ["mtgtop8.js"]
    }
  ]
}
